{
  "name": "wavepod",
  "productName": "WavePod",
  "version": "0.9.0",
  "description": "A simple multitrack DAW for podcasting",
  "author": "Michael Kleinhenz <michael@kleinhenz.net>",
  "license": "MIT",
  "main": "dist/main/main.js",
  "homepage": "https://github.com/michaelkleinhenz/wavepod",
  "repository": "github:michaelkleinhenz/wavepod",
  "scripts": {
    "build": "node scripts/build-audify.mjs && node scripts/build.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "postinstall": "patch-package && node scripts/build-audify.mjs"
  },
  "build": {
    "appId": "net.kleinhenz.wavepod",
    "productName": "WavePod",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/audify/**",
      "**/node_modules/opusscript/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "native/vsthost/bin",
        "to": "vsthost",
        "filter": [
          "wavepod-vsthost",
          "wavepod-vsthost.exe"
        ]
      },
      {
        "from": ".",
        "to": "licenses",
        "filter": [
          "LICENSE",
          "THIRD_PARTY_NOTICES.md",
          "LICENSES/**"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "syncDesktopName": true,
      "icon": "build/icons",
      "desktop": {
        "entry": {
          "GenericName": "Podcast Recorder",
          "Keywords": "podcast;record;audio;multitrack;daw;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libpulse0"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "WavePod records audio from your audio interface."
      },
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "audify": "^1.10.1",
    "opusscript": "^0.1.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@types/node": "^22.20.5",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "patch-package": "^8.0.1",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "desktopName": "wavepod.desktop"
}
