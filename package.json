{
  "name": "wavepod",
  "productName": "WavePod",
  "version": "0.1.0",
  "description": "A simple multitrack DAW for podcasting",
  "author": "Michael Kleinhenz <michael@kleinhenz.net>",
  "license": "UNLICENSED",
  "main": "dist/main/main.js",
  "homepage": "https://github.com/michaelkleinhenz/wavepod",
  "repository": "github:michaelkleinhenz/wavepod",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "net.kleinhenz.wavepod",
    "productName": "WavePod",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/audify/**",
      "**/node_modules/opusscript/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "native/vsthost/bin",
        "to": "vsthost",
        "filter": [
          "wavepod-vsthost",
          "wavepod-vsthost.exe"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "syncDesktopName": true,
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "WavePod records audio from your audio interface."
      },
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "audify": "^1.10.1",
    "opusscript": "^0.1.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@types/node": "^22.20.5",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "desktopName": "wavepod.desktop"
}
