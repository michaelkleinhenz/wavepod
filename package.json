{
  "name": "soundpod",
  "productName": "SoundPod",
  "version": "0.1.0",
  "description": "A simple multitrack DAW for podcasting",
  "author": "Michael Kleinhenz <michael@kleinhenz.net>",
  "license": "MIT",
  "main": "dist/main/main.js",
  "homepage": "https://github.com/michaelkleinhenz/soundpod",
  "repository": "github:michaelkleinhenz/soundpod",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "net.kleinhenz.soundpod",
    "productName": "SoundPod",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/audify/**"
    ],
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "SoundPod records audio from your audio interface."
      }
    }
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "audify": "^1.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
